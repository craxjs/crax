{
  "name": "@craxjs/crax",
  "version": "0.0.1",
  "description": "Scaffold a new CRAX project, Vite + React + file-based routing + built-in state management",
  "type": "module",
  "bin": {
    "crax": "./dist/index.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.9.0",
    "vitest": "^3.1.0"
  },
  "keywords": ["crax", "react", "vite", "spa", "scaffold"],
  "license": "MIT"
}
