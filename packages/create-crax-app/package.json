{
  "name": "@craxjs/crax",
  "version": "1.1.1",
  "description": "Lightweight React framework built on Vite. A Next.js alternative that brings back the simplicity of Create React App.",
  "type": "module",
  "bin": {
    "crax": "./dist/index.js"
  },
  "files": [
    "dist",
    "template",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build",
    "postpublish": "git tag v$npm_package_version && git push origin v$npm_package_version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craxjs/crax.git",
    "directory": "packages/create-crax-app"
  },
  "homepage": "https://craxjs.github.io/crax/",
  "bugs": {
    "url": "https://github.com/craxjs/crax/issues"
  },
  "keywords": [
    "crax",
    "react",
    "vite",
    "spa",
    "framework",
    "nextjs-alternative",
    "create-react-app",
    "frontend"
  ],
  "author": "Hussein Kizz",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "^5.9.0",
    "vitest": "^3.1.0"
  }
}
